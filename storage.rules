rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // 1. Allow public read access for all food images, restaurant logos, banners & QR codes
      // This is required so mobile app customers, web visitors, and admin dashboard can view images.
      allow read: if true;

      // 2. Allow authenticated users (Admins, Branch Managers) to upload and manage files
      allow write: if request.auth != null;
    }
  }
}

